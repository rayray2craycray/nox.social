    "@react-native-community/slider": "4.5.6",
    "@rork-ai/toolkit-sdk": "^0.2.51",
    "@sentry/react-native": "~6.14.0",
    "@stardazed/streams-text-encoding": "^1.0.2",
    "@tanstack/react-query": "^5.83.0",
